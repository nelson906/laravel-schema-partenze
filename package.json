{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc -p tsconfig.json",
        "qa": "npm run lint && npm run typecheck && npm run test"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@vitest/coverage-v8": "^4.1.6",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.39.5",
        "eslint-plugin-import-x": "^4.17.1",
        "globals": "^15.15.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "typescript": "^7.0.2",
        "vite": "^7.0.7",
        "vitest": "^4.1.6"
    }
}
